<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>CaveExplorer</AssemblyName>
    <RootNamespace>CaveExplorer</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Andiron</Authors>
    <Description>Path map for caves and mines in The Long Dark</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>bin\Debug\</OutputPath>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>bin\Release\</OutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ModData">
      <HintPath>MelonLoader_Libs\ModData.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="ModSettings">
    <HintPath>MelonLoader_Libs\ModSettings.dll</HintPath>
    <Private>False</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>MelonLoader_Libs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Assembly-CSharp">
      <HintPath>MelonLoader_Libs\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Il2Cpp">
      <HintPath>MelonLoader_Libs\Il2Cpp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Il2CppTLD.IntBackedUnit">
      <HintPath>MelonLoader_Libs\Il2CppTLD.IntBackedUnit.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Il2CppTLD.GameplayTag">
      <HintPath>MelonLoader_Libs\Il2CppTLD.GameplayTag.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>MelonLoader_Libs\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Il2Cppmscorlib">
      <HintPath>MelonLoader_Libs\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="MelonLoader">
      <HintPath>MelonLoader_Libs\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Unity.Addressables">
      <HintPath>MelonLoader_Libs\Unity.Addressables.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>MelonLoader_Libs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>MelonLoader_Libs\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>MelonLoader_Libs\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>MelonLoader_Libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>MelonLoader_Libs\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>MelonLoader_Libs\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.UI">
      <HintPath>MelonLoader_Libs\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.UIModule">
      <HintPath>MelonLoader_Libs\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>MelonLoader_Libs\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>MelonLoader_Libs\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>MelonLoader_Libs\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

  </ItemGroup>

  <!-- Release build: release\CaveExplorer.zip with the DLL and README -->
  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageStagingDir>$(BaseIntermediateOutputPath)package\</PackageStagingDir>
      <ReleaseDir>$(MSBuildProjectDirectory)\release\</ReleaseDir>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageStagingDir)" />
    <Copy SourceFiles="$(TargetPath);README.md" DestinationFolder="$(PackageStagingDir)" />
    <MakeDir Directories="$(ReleaseDir)" />
    <ZipDirectory SourceDirectory="$(PackageStagingDir)" DestinationFile="$(ReleaseDir)$(AssemblyName).zip" Overwrite="true" />
  </Target>

</Project>